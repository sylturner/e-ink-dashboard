<% content_for :title, "Add a source" %>

<h1>Add a source</h1>

<ul class="type-list">
  <% Source::PROVIDERS.each do |type| %>
    <li>
      <%= link_to Source.provider_label(type),
                  new_source_path(type: type), class: "btn" %>
    </li>
  <% end %>
</ul>

<p><%= link_to "Back to sources", sources_path %></p>
