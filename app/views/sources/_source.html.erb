<div id="<%= dom_id source %>">
  <div>
    <strong>Name:</strong>
    <%= source.name %>
  </div>

  <div>
    <strong>Providable:</strong>
    <%= source.providable_id %>
  </div>

  <div>
    <strong>Refresh seconds:</strong>
    <%= source.refresh_seconds %>
  </div>

  <div>
    <strong>Payload:</strong>
    <%= source.payload %>
  </div>

  <div>
    <strong>Fetched at:</strong>
    <%= source.fetched_at %>
  </div>

  <div>
    <strong>Attempted at:</strong>
    <%= source.attempted_at %>
  </div>

  <div>
    <strong>Last error:</strong>
    <%= source.last_error %>
  </div>

  <div>
    <strong>Failure count:</strong>
    <%= source.failure_count %>
  </div>

</div>
