<%= page_header "Sources", icon: "cil-rss",
                description: "The weather, calendars and feeds your tiles draw from. Each source refreshes on its own schedule." do %>
  <%= link_to new_source_path, class: "btn btn-light" do %>
    <%= ui_icon "cil-plus", classes: "icon me-1" %> Add a source
  <% end %>
<% end %>

<% if @sources.any? %>
  <div class="card">
    <%# Scrolls sideways inside its own box on narrow screens rather than
        widening the page (WCAG 1.4.10); focusable and labeled so keyboard
        and screen reader users can reach and scroll it. Positioned, so the
        buttons' visually hidden text is clipped with the table instead of
        escaping the box and widening the page after all. %>
    <div class="table-responsive position-relative" role="region" aria-label="Sources" tabindex="0">
      <table class="table table-hover align-middle mb-0 sources">
        <thead class="text-nowrap">
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Type</th>
            <th scope="col">Detail</th>
            <th scope="col">Last fetch</th>
            <th scope="col">Health</th>
            <th scope="col">Used by</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @sources.each do |source| %>
            <tr>
              <td class="fw-semibold"><%= link_to source.name, edit_source_path(source) %></td>
              <td class="text-nowrap">
                <%= ui_icon source.providable_class.icon, classes: "icon me-1" %><%= source.kind_label %>
              </td>
              <td class="small font-monospace text-body-secondary text-break"><%= source.providable.detail %></td>
              <td class="text-nowrap"><%= relative_time_tag(source.fetched_at) %></td>
              <td><%= source_health(source) %></td>
              <td class="text-nowrap"><%= pluralize(source.dashboard_items.size, "tile") %></td>
              <td class="text-nowrap text-end">
                <% if source.providable_class.polls? %>
                  <%= button_to test_source_path(source), method: :post,
                                class: "btn btn-sm btn-app-outline", form: { class: "d-inline-block" } do %>
                    Test<span class="visually-hidden"> <%= source.name %></span>
                  <% end %>
                <% end %>
                <%= button_to source, method: :delete,
                              class: "btn btn-sm btn-app-outline",
                              form: { class: "d-inline-block", data: { turbo_confirm: "Delete #{source.name}?" } } do %>
                  Delete<span class="visually-hidden"> <%= source.name %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card">
    <div class="card-body text-center py-5">
      <p>There are no sources yet.</p>
      <%= link_to "Add a source", new_source_path, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
