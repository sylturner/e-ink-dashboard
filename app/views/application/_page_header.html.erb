<%# Rendered by PageHeaderHelper#page_header. %>
<header class="page-hero d-flex flex-wrap align-items-center gap-4 mb-4">
  <div class="me-auto">
    <div class="d-flex align-items-center gap-3">
      <span class="page-hero-icon"><%= ui_icon icon, classes: "icon icon-xl" %></span>
      <h1 class="h2 mb-0"><%= title %></h1>
    </div>
    <% if description %>
      <p class="mt-3 mb-0"><%= description %></p>
    <% end %>
  </div>

  <% if actions %>
    <div class="d-flex flex-wrap gap-2"><%= actions %></div>
  <% end %>
</header>
