<%
  limit = item.setting("event_limit").to_i
  entries = NewsFeed.for(item)
  # A feed can mix items with and without pictures; the images layout
  # skips the ones it has nothing to draw for.
  entries = entries.select { it["image"].present? } if item.view == "images"
  entries = entries.first(limit)
%>
<div class="feed">
  <% case item.view %>
  <% when "headlines" %>
    <ul class="rows rows--stacked">
      <% entries.each do |entry| %>
        <li>
          <span class="t-clip t-clip-2"><%= entry["title"] %></span>
          <% if item.shows?("source") && entry["source"].present? %>
            <span class="t-xs nowrap"><%= entry["source"] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% when "images" %>
    <% entries.each do |entry| %>
      <img src="<%= entry["image"] %>"/>
    <% end %>
  <% end %>
</div>
