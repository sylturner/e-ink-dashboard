<%
  # Weeks start on the app's chosen day (Date.beginning_of_week, set by
  # AppSetting#apply).
  first = now.to_date.beginning_of_month
  start = first.beginning_of_week
  last  = now.to_date.end_of_month.end_of_week
%>

<div class="month">
  <div class="month-head">
    <% (start...start + 7).each do |day| %>
      <div class="t-xs"><%= l(day, format: "%a")[0] %></div>
    <% end %>
  </div>

  <div class="month-grid">
    <% (start..last).each do |date| %>
      <%
        outside = date.month != first.month
        today   = date == now.to_date
        count   = EventFeed.on_day(events, date).size
      %>
      <div class="month-cell<%= " month-cell--today" if today %><%= " month-cell--outside" if outside %>">
        <span class="t-xs"><%= date.day %></span>
        <% if count.positive? && !outside %>
          <span class="month-dots">
            <%= "•" * [ count, 3 ].min %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
