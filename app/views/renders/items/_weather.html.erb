<div class="weather">
  <% case item.view %>
  <% when "hourly" %>
    <%= render "renders/items/weather/hourly", hours: (data["hourly"] || []).first(item.setting("hour_count").to_i) %>
  <% when "forecast" %>
    <%= render "renders/items/weather/forecast", days: (data["daily"] || []).first(item.setting("day_count").to_i) %>
  <% else %>
    <%= render "renders/items/weather/today", current: data["current"], today: (data["daily"] || []).first %>
  <% end %>
</div>
