<% case item.view %>
<% when "hourly" %>
  <div class="hours">
    <% (data["hourly"] || []).first(6).each do |h| %>
      <div class="hour">
        <div class="t-xs"><%= h["hour"] %></div>
        <%= weather_icon(h["icon"], scale: 1) %>
        <div class="t-sm"><%= h["temp"] %>&deg;</div>
      </div>
    <% end %>
  </div>

<% when "forecast" %>
  <ul class="rows">
    <% days = item.settings["day_count"].to_i %>
    <% (data["daily"] || []).first(days.positive? ? days : 5).each do |d| %>
      <li>
        <span class="t-sm"><%= d["day"] %></span>
        <span><%= weather_icon(d["icon"], scale: 1) %></span>
        <span class="t-sm"><%= d["high"] %>&deg; / <%= d["low"] %>&deg;</span>
      </li>
    <% end %>
  </ul>

<% else %>
  <% c = data["current"] || {} %>
  <div class="now">
    <%= weather_icon(c["icon"], scale: 3) %>
    <div>
      <div class="t-lg"><%= c["temp"] %>&deg;</div>
      <div class="t-xs"><%= c["label"] %></div>
      <div class="t-xs">Feels <%= c["feels_like"] %>&deg;</div>
    </div>
  </div>
  <% today = (data["daily"] || []).first %>
  <% if today %>
    <div class="t-xs">
      H <%= today["high"] %>&deg; &middot; L <%= today["low"] %>&deg;
      <%= "· #{today["precip"]}%" if today["precip"].to_i.positive? %>
    </div>
  <% end %>
<% end %>
