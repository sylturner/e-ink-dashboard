<%= tag.div class: [ "card", "card--#{item.kind}", *item.look.classes ], style: item.grid_style do %>
  <% if item.title.present? %>
    <div class="card-header"><%= item.title %></div>
  <% end %>

  <div class="card-body">
    <%= render "renders/items/#{item.kind}",
               item: item, now: now, data: item.sources.first&.payload || {} %>
  </div>

  <% if item.sources.any? %>
    <%= render "renders/staleness", item: item, now: now %>
  <% end %>
<% end %>
