<%# The pixel fonts tiles chose for their own look (TileLook), each once. %>
<% if (look_css = TileLook.css(@items.map(&:look))).present? %>
  <style><%= raw look_css %></style>
<% end %>

<div class="grid"
     style="--grid-cols: <%= @dashboard.grid_columns %>;
            --grid-rows: <%= @dashboard.grid_rows %>;">
  <% @items.each do |item| %>
    <%= render "renders/item", item: item, now: @now %>
  <% end %>
</div>

<% if fits_type? %>
  <%= render "renders/fit_type" %>
<% end %>

<%# A panel's navigation strip, which takes the foot of the screen. %>
<% if (navigation = @device&.navigation(@dashboard)) %>
  <%= render "renders/navigation", navigation: %>
<% end %>
