<%# A panel as a card: the frame it was last sent, then its name, which
    opens its page and makes the whole card a link. The footer is raised
    above that link so its buttons stay clickable. %>
<article id="<%= dom_id device %>" class="card h-100 panel-card">
  <%= render "devices/last_frame", device:, framed:, classes: "card-img-top" %>

  <div class="card-body">
    <h2 class="h5 card-title">
      <%= link_to device.name, edit_device_path(device),
                  class: "stretched-link link-body-emphasis text-decoration-none" %>
    </h2>
    <% if device.dashboard %>
      <p class="card-text small text-body-secondary mb-2">Showing <%= device.dashboard.name %></p>
    <% end %>
    <p class="card-text mb-2"><%= device_check_in(device) %></p>
    <ul class="list-unstyled small mb-0">
      <li><span class="visually-hidden">Battery: </span><%= device_battery(device) %></li>
      <li><span class="visually-hidden">Signal: </span><%= device_signal(device) %></li>
    </ul>
  </div>

  <div class="card-footer bg-transparent d-flex flex-wrap justify-content-end gap-2 position-relative z-2">
    <%# Short, so both buttons fit on one line of a narrow card. The flash
        after it, and the full name to screen readers, say when. %>
    <%= button_to refresh_device_path(device), class: "btn btn-sm btn-app-outline me-auto" do %>
      <%= ui_icon "cil-reload", classes: "icon me-1" %>Refresh<span class="visually-hidden"> <%= device.name %> on next wake</span>
    <% end %>
    <%= button_to device, method: :delete, class: "btn btn-sm btn-app-outline",
                  form: { data: { turbo_confirm: "Delete #{device.name}?" } } do %>
      Delete<span class="visually-hidden"> <%= device.name %></span>
    <% end %>
  </div>
</article>
