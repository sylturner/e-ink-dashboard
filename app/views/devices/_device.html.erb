<div id="<%= dom_id device %>">
  <div>
    <strong>Name:</strong>
    <%= device.name %>
  </div>

  <div>
    <strong>Token:</strong>
    <%= device.token %>
  </div>

  <div>
    <strong>Currently showing:</strong>
    <%= device.dashboard ? link_to(device.dashboard.name, builder_dashboard_path(device.dashboard)) : "(none)" %>
  </div>

  <div>
    <strong>Assigned dashboards:</strong>
    <% if device.dashboards.any? %>
      <ul class="device-assignments">
        <% device.device_dashboards.includes(:dashboard).each do |assignment| %>
          <li>
            <%= link_to assignment.dashboard.name, builder_dashboard_path(assignment.dashboard) %>
            <%= "· showing" if assignment.dashboard_id == device.dashboard_id %>
            <%= button_to "Unassign", device_dashboard_path(assignment), method: :delete,
                          form: { class: "inline-form" } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      (none)
    <% end %>
  </div>

  <div>
    <strong>Width:</strong>
    <%= device.width %>
  </div>

  <div>
    <strong>Height:</strong>
    <%= device.height %>
  </div>

  <div>
    <strong>Bit depth:</strong>
    <%= device.bit_depth %>
  </div>

  <div>
    <strong>Image format:</strong>
    <%= device.image_format %>
  </div>

  <div>
    <strong>Dither:</strong>
    <%= device.dither.humanize %>
  </div>

  <div>
    <strong>Rotation:</strong>
    <%= device.rotation %>
  </div>

  <div>
    <strong>Refresh seconds:</strong>
    <%= device.refresh_seconds %>
  </div>

  <div>
    <strong>Night refresh seconds:</strong>
    <%= device.night_refresh_seconds %>
  </div>

  <div>
    <strong>Active from hour:</strong>
    <%= device.active_from_hour %>
  </div>

  <div>
    <strong>Active until hour:</strong>
    <%= device.active_until_hour %>
  </div>

  <div>
    <strong>Time zone:</strong>
    <%= device.time_zone %>
  </div>

  <div>
    <strong>Last seen at:</strong>
    <%= device.last_seen_at %>
  </div>

  <div>
    <strong>Battery percent:</strong>
    <%= device.battery_percent %>
  </div>

  <div>
    <strong>Battery voltage:</strong>
    <%= device.battery_voltage %>
  </div>

  <div>
    <strong>Wifi rssi:</strong>
    <%= device.wifi_rssi %>
  </div>

  <div>
    <strong>Firmware version:</strong>
    <%= device.firmware_version %>
  </div>

  <div>
    <strong>Refresh requested at:</strong>
    <%= device.refresh_requested_at %>
  </div>

</div>
