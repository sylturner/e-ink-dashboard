<%# A device's settings: a card on its page, and all there is to the new
    page. What the panel reports -- battery, signal, firmware, check-ins --
    isn't editable. %>
<section class="card device-settings" aria-labelledby="device-settings-heading">
  <div class="card-header">
    <h2 id="device-settings-heading" class="h6 mb-0">Settings</h2>
  </div>

  <div class="card-body">
    <%= form_with model: device do |f| %>
      <%= f.error_messages %>

      <div class="mb-3">
        <%= f.label :name %>
        <%= f.text_field :name %>
        <%= f.invalid_feedback :name %>
      </div>

      <fieldset class="border-top pt-3 mb-3">
        <legend class="fs-6 fw-semibold">Display</legend>

        <div class="row g-3 mb-3">
          <div class="col-sm-6">
            <%= f.label :width, "Width (pixels)" %>
            <%= f.number_field :width, min: 1 %>
            <%= f.invalid_feedback :width %>
          </div>
          <div class="col-sm-6">
            <%= f.label :height, "Height (pixels)" %>
            <%= f.number_field :height, min: 1 %>
            <%= f.invalid_feedback :height %>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-sm-4">
            <%= f.label :bit_depth %>
            <%= f.select :bit_depth, Device::BIT_DEPTHS.map { [ "#{it}-bit", it ] }, {},
                         aria: { describedby: f.field_id(:bit_depth, :hint) } %>
            <%= f.invalid_feedback :bit_depth %>
          </div>
          <div class="col-sm-4">
            <%= f.label :image_format, "Format" %>
            <%= f.select :image_format, Device::IMAGE_FORMATS.map { [ it.upcase, it ] } %>
            <%= f.invalid_feedback :image_format %>
          </div>
          <div class="col-sm-4">
            <%= f.label :rotation %>
            <%= f.select :rotation, Device::ROTATIONS.map { [ "#{it}°", it ] } %>
            <%= f.invalid_feedback :rotation %>
          </div>
          <div id="<%= f.field_id(:bit_depth, :hint) %>" class="form-text mt-1">
            The panel reports its size, depth and format when it enrolls. Only
            1-bit frames can be rendered so far.
          </div>
        </div>

        <div class="mb-0">
          <%= f.label :dither %>
          <%= f.select :dither, Device::DITHER_OPTIONS.map { [ it.humanize, it ] }, {},
                       aria: { describedby: f.field_id(:dither, :hint) } %>
          <%= f.invalid_feedback :dither %>
          <div id="<%= f.field_id(:dither, :hint) %>" class="form-text">
            How grays become black and white on a 1-bit panel. "None" snaps each
            pixel to the nearest; the others trade grays for dot patterns.
          </div>
        </div>
      </fieldset>

      <fieldset class="border-top pt-3 mb-3">
        <legend class="fs-6 fw-semibold">Schedule</legend>

        <div class="row g-3 mb-3">
          <div class="col-sm-6">
            <%= f.label :refresh_seconds, "Daytime check-in (seconds)" %>
            <%= f.number_field :refresh_seconds, min: Device::MIN_SLEEP, max: Device::MAX_SLEEP,
                               aria: { describedby: f.field_id(:refresh_seconds, :hint) } %>
            <%= f.invalid_feedback :refresh_seconds %>
          </div>
          <div class="col-sm-6">
            <%= f.label :night_refresh_seconds, "Nighttime check-in (seconds)" %>
            <%= f.number_field :night_refresh_seconds, min: Device::MIN_SLEEP, max: Device::MAX_SLEEP,
                               aria: { describedby: f.field_id(:refresh_seconds, :hint) } %>
            <%= f.invalid_feedback :night_refresh_seconds %>
          </div>
          <div id="<%= f.field_id(:refresh_seconds, :hint) %>" class="form-text mt-1">
            How long the panel sleeps between check-ins: <%= Device::MIN_SLEEP %> to
            <%= Device::MAX_SLEEP %> seconds (6 hours).
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-6">
            <%= f.label :active_from_hour, "Daytime starts" %>
            <%= f.select :active_from_hour, hour_options(0..23), {},
                         aria: { describedby: f.field_id(:active_from_hour, :hint) } %>
            <%= f.invalid_feedback :active_from_hour %>
          </div>
          <div class="col-6">
            <%= f.label :active_until_hour, "Daytime ends" %>
            <%= f.select :active_until_hour, hour_options(1..24), {},
                         aria: { describedby: f.field_id(:active_from_hour, :hint) } %>
            <%= f.invalid_feedback :active_until_hour %>
          </div>
          <div id="<%= f.field_id(:active_from_hour, :hint) %>" class="form-text mt-1">
            In the panel's time zone. Outside these hours it checks in at the
            nighttime rate.
          </div>
        </div>

        <div class="mb-0">
          <%= f.label :time_zone %>
          <%= f.text_field :time_zone, autocomplete: "off", spellcheck: false,
                           aria: { describedby: f.field_id(:time_zone, :hint) } %>
          <%= f.invalid_feedback :time_zone %>
          <div id="<%= f.field_id(:time_zone, :hint) %>" class="form-text">
            A name like America/Los_Angeles. Leave it blank to use the server's,
            <%= Time.zone.name %>.
          </div>
        </div>
      </fieldset>

      <%= f.submit device.new_record? ? "Create device" : "Save device" %>
    <% end %>
  </div>

  <% if device.persisted? %>
    <div class="card-footer bg-transparent">
      <%= button_to "Delete device", device, method: :delete,
                    class: "btn btn-sm btn-app-outline",
                    form: { data: { turbo_confirm: "Delete #{device.name_in_database}?" } } %>
    </div>
  <% end %>
</section>
