<% content_for :title, "#{@dashboard.name} builder" %>

<%
  # Canvas metrics. These mirror render.css exactly: an 800x480 panel
  # divided into equal 1fr tracks with --grid-gap between them. The
  # guide lines below are drawn from the same arithmetic, so a tile in
  # the builder lands on the same pixels as it does in the render.
  gap    = 8
  canvas = { w: 800, h: 480 }
  step_x = (canvas[:w] - (@dashboard.grid_columns - 1) * gap) / @dashboard.grid_columns.to_f + gap
  step_y = (canvas[:h] - (@dashboard.grid_rows - 1) * gap) / @dashboard.grid_rows.to_f + gap
%>

<div class="builder"
     data-controller="grid"
     data-grid-cols-value="<%= @dashboard.grid_columns %>"
     data-grid-rows-value="<%= @dashboard.grid_rows %>"
     data-action="pointermove@window->grid#move
                  pointerup@window->grid#end
                  pointercancel@window->grid#end
                  keydown@window->grid#nudge">

  <header class="builder-bar">
    <h1><%= @dashboard.name %></h1>

    <%= form_with model: @dashboard, class: "inline-form" do |f| %>
      <%= hidden_field_tag :from_builder, "1" %>
      <%= f.label :theme %>
      <%= f.select :theme,
                   Dashboard::THEMES.map { |t| [ t.titleize, t ] },
                   {},
                   data: { action: "change->grid#submit" } %>
    <% end %>

    <%= link_to "Dashboards", dashboards_path, class: "btn" %>
  </header>

  <% if flash[:alert].present? || flash[:notice].present? %>
    <p class="builder-flash"><%= flash[:alert] || flash[:notice] %></p>
  <% end %>

  <div class="builder-main">

    <section class="builder-canvas-wrap">
      <div class="builder-canvas"
           data-grid-target="canvas"
           style="--grid-gap: <%= gap %>px;
                  --rule-x: <%= step_x.round(3) %>px;
                  --rule-y: <%= step_y.round(3) %>px;
                  width: <%= canvas[:w] %>px; height: <%= canvas[:h] %>px;">

        <div class="builder-rules" aria-hidden="true"></div>

        <% @items.each do |item| %>
          <div class="tile"
               data-grid-target="tile"
               data-id="<%= item.id %>"
               data-col="<%= item.col %>"
               data-row="<%= item.row %>"
               data-col-span="<%= item.col_span %>"
               data-row-span="<%= item.row_span %>"
               data-action="pointerdown->grid#start">
            <div class="tile-label">
              <strong><%= item.title.presence || item.kind %></strong>
              <span><%= item.kind %><%= " · #{item.view}" if item.view.present? %></span>
            </div>
            <span class="tile-handle" data-handle="se"></span>
          </div>
        <% end %>
      </div>

      <p class="builder-status" data-grid-target="status">
        Drag to move. Drag the corner to resize. Arrow keys nudge, shift+arrow resizes.
      </p>
    </section>

    <aside class="builder-side">
      <%= render "dashboards/palette", dashboard: @dashboard, sources: @sources %>

      <turbo-frame id="inspector">
        <p class="muted">Select a tile to edit it.</p>
      </turbo-frame>
    </aside>
  </div>

  <section class="builder-preview">
    <h2>Preview</h2>
    <iframe data-grid-target="preview"
            src="<%= render_dashboard_path(dashboard_id: @dashboard.id) %>"
            width="800" height="480"
            title="Dashboard preview"></iframe>

    <%# The iframe above is the HTML the panel is rendered from. These go
        to the actual bitmap each device is served, which is the same
        bytes the hardware fetches. %>
    <div class="device-previews">
      <% if @devices.any? %>
        <h3>Bitmap as served to each device</h3>
        <ul class="device-list">
          <% @devices.each do |device| %>
            <li>
              <%= link_to "#{device.name} bitmap",
                          device_frame_path(token: device.token),
                          target: "_blank", rel: "noopener", class: "btn" %>
              <span class="device-spec">
                <%= device.width %>&times;<%= device.height %> &middot;
                <%= device.bit_depth %>-bit <%= device.image_format
                %><% if device.rotation.to_i.nonzero? %> &middot; <%= device.rotation %>&deg;<% end %>
              </span>
              <%= link_to "settings", device_path(device), class: "device-settings" %>
              <%= button_to "Unassign",
                            device_dashboard_path(@assignments.fetch(device.id)),
                            method: :delete,
                            params: { context: "builder" },
                            form: { class: "inline-form" } %>
            </li>
          <% end %>
        </ul>
        <p class="hint">
          Opens the live bitmap. Requesting it renders a fresh frame if one
          is due, and counts as a check-in for that device.
        </p>
      <% else %>
        <p class="hint">
          No device is assigned to this dashboard yet, so there is no bitmap
          to serve.
        </p>
      <% end %>

      <% if @assignable_devices.any? %>
        <%= form_with model: DeviceDashboard.new, class: "assign-device" do |f| %>
          <%= f.hidden_field :dashboard_id, value: @dashboard.id %>
          <%= hidden_field_tag :context, "builder" %>
          <%= f.label :device_id, "Assign to device" %>
          <%= f.collection_select :device_id, @assignable_devices, :id, :name %>
          <%= f.submit "Assign" %>
        <% end %>
      <% elsif @devices.any? %>
        <p class="hint">Every device is already assigned to this dashboard.</p>
      <% else %>
        <p class="hint"><%= link_to "Create a device", new_device_path %> to show this dashboard.</p>
      <% end %>
    </div>
  </section>
</div>
