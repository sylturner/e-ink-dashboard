<% content_for :title, "#{@dashboard.name} builder" %>
<%# The 800px canvas and the inspector side by side outgrow container-lg. %>
<% content_for :container_class, "container-fluid" %>

<%
  # Canvas metrics. These mirror render.css exactly: an 800x480 panel
  # divided into equal 1fr tracks with --grid-gap between them. The
  # guide lines below are drawn from the same arithmetic, so a tile in
  # the builder lands on the same pixels as it does in the render.
  gap    = 8
  canvas = { w: 800, h: 480 }
  step_x = (canvas[:w] - (@dashboard.grid_columns - 1) * gap) / @dashboard.grid_columns.to_f + gap
  step_y = (canvas[:h] - (@dashboard.grid_rows - 1) * gap) / @dashboard.grid_rows.to_f + gap
%>

<div class="builder"
     data-controller="grid"
     data-grid-cols-value="<%= @dashboard.grid_columns %>"
     data-grid-rows-value="<%= @dashboard.grid_rows %>"
     data-action="pointermove@window->grid#move
                  pointerup@window->grid#end
                  pointercancel@window->grid#end
                  keydown@window->grid#nudge">

  <div class="d-flex flex-wrap align-items-end gap-3 mb-4">
    <div class="me-auto">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><%= link_to "Dashboards", dashboards_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Builder</li>
        </ol>
      </nav>
      <h1 class="h3 mb-0"><%= @dashboard.name %></h1>
    </div>

    <%= form_with model: @dashboard, class: "d-flex align-items-center gap-2" do |f| %>
      <%= hidden_field_tag :from_builder, "1" %>
      <%= f.label :theme, class: "mb-0" %>
      <%= f.select :theme,
                   Dashboard::THEMES.map { |t| [ t.titleize, t ] },
                   {},
                   class: "form-select-sm", data: { action: "change->grid#submit" } %>
    <% end %>

    <%= link_to "Settings", edit_dashboard_path(@dashboard), class: "btn btn-sm btn-app-outline" %>
  </div>

  <div class="builder-main">

    <section class="card builder-stage" aria-labelledby="builder-layout-heading">
      <div class="card-header d-flex align-items-center gap-2">
        <h2 id="builder-layout-heading" class="h6 mb-0 me-auto">Layout</h2>
        <span class="small text-body-secondary">
          <%= @dashboard.grid_columns %>&thinsp;&times;&thinsp;<%= @dashboard.grid_rows %> grid
        </span>
      </div>

      <div class="card-body p-2">
        <div class="builder-canvas-wrap">
          <div class="builder-canvas"
               data-grid-target="canvas"
               style="--grid-gap: <%= gap %>px;
                      --rule-x: <%= step_x.round(3) %>px;
                      --rule-y: <%= step_y.round(3) %>px;
                      width: <%= canvas[:w] %>px; height: <%= canvas[:h] %>px;">

            <div class="builder-rules" aria-hidden="true"></div>

            <% @items.each do |item| %>
              <%# Focusable buttons, so the canvas works without a pointer (WCAG
                  2.1.1): Enter or Space selects a tile, then the arrow keys move
                  it. grid_controller#describe keeps the label current as the
                  tile moves. %>
              <div class="tile"
                   role="button" tabindex="0" aria-pressed="false"
                   aria-label="<%= builder_tile_label(item) %>"
                   data-grid-target="tile"
                   data-id="<%= item.id %>"
                   data-name="<%= builder_tile_name(item) %>"
                   data-col="<%= item.col %>"
                   data-row="<%= item.row %>"
                   data-col-span="<%= item.col_span %>"
                   data-row-span="<%= item.row_span %>"
                   data-edit-url="<%= edit_dashboard_item_path(item) %>"
                   data-reposition-url="<%= reposition_dashboard_item_path(item) %>"
                   data-action="pointerdown->grid#start
                                keydown.enter->grid#pick:prevent
                                keydown.space->grid#pick:prevent">
                <div class="tile-label" aria-hidden="true">
                  <strong><%= builder_tile_title(item) %></strong>
                  <span><%= item.kind %><%= " · #{item.view}" if item.view.present? %></span>
                </div>
                <span class="tile-handle" data-handle="se"></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="card-body pt-2 builder-caption">
        <%# A live region, so "Saving…", "Saved" and errors are announced (4.1.3). %>
        <p class="builder-status small text-body-secondary" data-grid-target="status" role="status">
          Drag a tile to move it, or its corner to resize it. Or select a tile
          and use the buttons below. From the keyboard: tab to a tile and press
          Enter, then use the arrow keys to move it and Shift+arrow to resize it.
        </p>

        <%# The pointer alternative to dragging (WCAG 2.5.7): the same one-step
            moves as the arrow keys, enabled once a tile is selected. %>
        <div class="builder-movers d-flex flex-wrap gap-2" role="group" aria-label="Move or resize the selected tile">
          <% DashboardsHelper::BUILDER_MOVERS.each do |group, resize, steps| %>
            <div class="btn-group btn-group-sm" role="group" aria-label="<%= group %>">
              <% steps.each do |label, dx, dy| %>
                <button type="button" class="btn btn-app-outline" disabled
                        data-grid-target="mover" data-action="grid#moveBy"
                        data-grid-dx-param="<%= dx %>" data-grid-dy-param="<%= dy %>"
                        data-grid-resize-param="<%= resize %>"><%= label %></button>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <div class="builder-side d-flex flex-column gap-4">
      <turbo-frame id="inspector" class="d-block">
        <section class="card" aria-labelledby="inspector-heading">
          <div class="card-header">
            <h2 id="inspector-heading" class="h6 mb-0">Tile</h2>
          </div>
          <div class="card-body">
            <p class="text-body-secondary mb-0">Select a tile to edit it.</p>
          </div>
        </section>
      </turbo-frame>

      <%= render "dashboards/palette", dashboard: @dashboard, sources: @sources %>
    </div>

    <section class="card builder-preview" aria-labelledby="builder-preview-heading">
      <div class="card-header">
        <h2 id="builder-preview-heading" class="h6 mb-0">Preview</h2>
      </div>

      <div class="card-body p-2">
        <%# Focusable and labeled, so keyboard users can scroll it when it is
            narrower than the panel (WCAG 2.1.1). %>
        <div class="builder-preview-frame" role="region" aria-label="Preview frame" tabindex="0">
          <iframe data-grid-target="preview"
                  src="<%= render_dashboard_path(dashboard_id: @dashboard.id) %>"
                  width="800" height="480"
                  title="Dashboard preview"></iframe>
        </div>
      </div>

      <%# The iframe above is the HTML the panel is rendered from. These go
          to the actual bitmap each device is served, which is the same
          bytes the hardware fetches. %>
      <div class="card-body border-top device-previews builder-caption">
        <h3 class="h6">Bitmap as served to each device</h3>

        <% if @devices.any? %>
          <ul class="list-group device-list mb-2">
            <% @devices.each do |device| %>
              <li class="list-group-item d-flex flex-wrap align-items-center column-gap-3 row-gap-2">
                <div class="me-auto">
                  <%= link_to "#{device.name} bitmap",
                              device_frame_path(token: device.token),
                              target: "_blank", rel: "noopener", class: "fw-semibold" %>
                  <div class="small text-body-secondary font-monospace">
                    <%= device.width %>&times;<%= device.height %> &middot;
                    <%= device.bit_depth %>-bit <%= device.image_format
                    %><% if device.rotation.to_i.nonzero? %> &middot; <%= device.rotation %>&deg;<% end %>
                  </div>
                </div>
                <%= link_to device_path(device), class: "btn btn-sm btn-app-outline" do %>
                  Settings<span class="visually-hidden"> for <%= device.name %></span>
                <% end %>
                <%= button_to device_dashboard_path(@assignments.fetch(device.id)),
                              method: :delete,
                              params: { context: "builder" },
                              class: "btn btn-sm btn-app-outline" do %>
                  Unassign<span class="visually-hidden"> <%= device.name %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
          <p class="small text-body-secondary">
            Opens the live bitmap. Requesting it renders a fresh frame if one
            is due, and counts as a check-in for that device.
          </p>
        <% else %>
          <p class="small text-body-secondary">
            No device is assigned to this dashboard yet, so there is no bitmap
            to serve.
          </p>
        <% end %>

        <% if @assignable_devices.any? %>
          <%= form_with model: DeviceDashboard.new, class: "assign-device" do |f| %>
            <%= f.hidden_field :dashboard_id, value: @dashboard.id %>
            <%= hidden_field_tag :context, "builder" %>
            <%= f.label :device_id, "Assign to a device" %>
            <div class="input-group">
              <%= f.collection_select :device_id, @assignable_devices, :id, :name %>
              <%= f.submit "Assign" %>
            </div>
          <% end %>
        <% elsif @devices.any? %>
          <p class="small text-body-secondary mb-0">Every device is already assigned to this dashboard.</p>
        <% else %>
          <p class="small text-body-secondary mb-0"><%= link_to "Create a device", new_device_path %> to show this dashboard.</p>
        <% end %>
      </div>
    </section>
  </div>
</div>
