<%= page_header "Dashboards", icon: "cil-speedometer",
                description: "Lay out tiles on a grid for your e-paper panels. Open a dashboard to edit it in the builder." do %>
  <%= link_to new_dashboard_path, class: "btn btn-light" do %>
    <%= ui_icon "cil-plus", classes: "icon me-1" %> New dashboard
  <% end %>
<% end %>

<% if @dashboards.any? %>
  <ul id="dashboards" class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 row-cols-xxl-4 g-4 list-unstyled">
    <% @dashboards.each do |dashboard| %>
      <li class="col"><%= render dashboard %></li>
    <% end %>
  </ul>
<% else %>
  <div class="card">
    <div class="card-body text-center py-5">
      <p>There are no dashboards yet.</p>
      <%= link_to "Create a dashboard", new_dashboard_path, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
