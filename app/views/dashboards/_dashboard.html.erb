<%# A dashboard as a card: its render as the panel shows it, then its
    name, which opens the builder and makes the whole card a link. The
    footer is raised above that link so its button stays clickable. %>
<% width, height = dashboard.screen_size %>
<% device_count = dashboard.devices.size %>
<article id="<%= dom_id dashboard %>" class="card h-100 dashboard-card">
  <%= image_tag dashboard_thumbnail_path(dashboard, format: :png),
                alt: dashboard_thumbnail_alt(dashboard), width:, height:,
                loading: "lazy", decoding: "async",
                class: "card-img-top h-auto dashboard-thumbnail" %>

  <div class="card-body">
    <h2 class="h5 card-title">
      <%= link_to dashboard.name, edit_dashboard_path(dashboard),
                  class: "stretched-link link-body-emphasis text-decoration-none" %>
    </h2>
    <p class="card-text small text-body-secondary mb-2">
      <%= dashboard.grid_columns %>&thinsp;&times;&thinsp;<%= dashboard.grid_rows %> grid
      &middot; <%= dashboard.theme.titleize %> theme
    </p>
    <span class="<%= class_names("badge",
                                 "bg-success-subtle text-success-emphasis": device_count.positive?,
                                 "bg-secondary-subtle text-secondary-emphasis": device_count.zero?) %>">
      <%= device_count.positive? ? "On #{pluralize(device_count, "device")}" : "Not on a device" %>
    </span>
  </div>

  <div class="card-footer bg-transparent d-flex justify-content-end position-relative z-2">
    <%= button_to dashboard, method: :delete, class: "btn btn-sm btn-app-outline",
                  form: { data: { turbo_confirm: "Delete #{dashboard.name}?" } } do %>
      Delete<span class="visually-hidden"> <%= dashboard.name %></span>
    <% end %>
  </div>
</article>
