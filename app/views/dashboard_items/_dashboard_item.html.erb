<div id="<%= dom_id dashboard_item %>">
  <div>
    <strong>Dashboard:</strong>
    <%= dashboard_item.dashboard_id %>
  </div>

  <div>
    <strong>Kind:</strong>
    <%= dashboard_item.kind %>
  </div>

  <div>
    <strong>View:</strong>
    <%= dashboard_item.view %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= dashboard_item.title %>
  </div>

  <div>
    <strong>Col:</strong>
    <%= dashboard_item.col %>
  </div>

  <div>
    <strong>Row:</strong>
    <%= dashboard_item.row %>
  </div>

  <div>
    <strong>Col span:</strong>
    <%= dashboard_item.col_span %>
  </div>

  <div>
    <strong>Row span:</strong>
    <%= dashboard_item.row_span %>
  </div>

  <div>
    <strong>Position:</strong>
    <%= dashboard_item.position %>
  </div>

  <div>
    <strong>Settings:</strong>
    <%= dashboard_item.settings %>
  </div>

  <div>
    <strong>Visible:</strong>
    <%= dashboard_item.visible %>
  </div>

</div>
