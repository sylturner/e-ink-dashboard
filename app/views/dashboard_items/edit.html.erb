<%# Wrapped in a Turbo Frame so selecting a tile swaps the inspector in
    place. The form itself targets _top, because saving changes the
    canvas (a new label, a different layout) and a frame-scoped response
    would leave the tiles behind it stale. Still renders standalone on a
    direct visit. %>
<turbo-frame id="inspector">
  <section class="card" aria-labelledby="inspector-heading">
    <div class="card-header">
      <h2 id="inspector-heading" class="h6 mb-0"><%= Component.label(@dashboard_item.kind) %> tile</h2>
    </div>

    <div class="card-body">
      <%= render "form", item: @dashboard_item %>
    </div>

    <div class="card-footer bg-transparent">
      <%= button_to "Delete tile", @dashboard_item, method: :delete,
                    class: "btn btn-sm btn-app-outline",
                    form: { data: { turbo_frame: "_top", turbo_confirm: "Delete this tile?" } } %>
    </div>
  </section>
</turbo-frame>
