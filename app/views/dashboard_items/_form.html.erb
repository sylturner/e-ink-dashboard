<%= form_with model: item, data: { controller: "item-form",
                                   turbo_frame: item.new_record? ? nil : "_top" } do |f| %>
  <%= f.error_messages %>

  <% if item.new_record? %>
    <div class="mb-3">
      <%= f.label :dashboard_id, "Dashboard" %>
      <%= f.collection_select :dashboard_id, Dashboard.order(:name), :id, :name %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :kind, "Component" %>
    <%= f.select :kind, component_options, {},
                 data: { action: "change->item-form#kindChanged" } %>
  </div>

  <div class="mb-3">
    <%= f.label :view, "Layout" %>
    <%= f.select :view,
                 Component.views(item.kind).map { |value, label| [ label, value ] },
                 {},
                 data: { action: "change->item-form#viewChanged",
                         item_form_target: "view" } %>
  </div>

  <div class="mb-3">
    <%= f.label :title, "Header (blank for none)" %>
    <%= f.text_field :title %>
  </div>

  <% allowed = Component.source_types(item.kind) %>
  <% if allowed.any? %>
    <% multi = Component.multi_source?(item.kind) %>
    <div class="mb-3">
      <%= f.label :source_ids, multi ? "Sources" : "Source" %>
      <%= f.collection_select :source_ids,
                              Source.where(providable_type: allowed).order(:name),
                              :id, :name,
                              { include_blank: !multi },
                              { multiple: multi, size: multi ? 4 : 1,
                                aria: { describedby: "item_sources_hint" } } %>
      <div id="item_sources_hint" class="form-text">
        <% if multi %>Select several to combine them into one view.<% end %>
        <%= link_to "Manage sources", sources_path %>
      </div>
    </div>
  <% end %>

  <% settings = Component.settings(item.kind) %>
  <% if settings.any? %>
    <fieldset class="mb-3 mw-100 border-0 p-0" data-item-form-target="options">
      <legend class="fs-6 fw-semibold p-0 mb-2">Options</legend>

      <%# Named dashboard_item[settings][key], and styled by the form builder. %>
      <%= f.fields_for :settings do |s| %>
        <% settings.each do |setting| %>
          <% value = item.setting(setting.key) %>
          <div class="<%= class_names("setting mb-3", "form-check": setting.type == :boolean) %>"
               data-item-form-target="setting"
               data-views="<%= Array(setting.views).join(" ") %>">
            <% case setting.type %>
            <% when :boolean %>
              <%# The checkbox's hidden "0" partner is what lets a box be
                  turned back off: settings are assigned as a whole hash, so
                  an omitted key would silently fall back to the registry
                  default. %>
              <%= s.checkbox setting.key, checked: value %>
              <%= s.label setting.key, setting.label, class: "form-check-label" %>
            <% when :integer %>
              <%= s.label setting.key, setting.label %>
              <%= s.number_field setting.key, value:, min: 1 %>
            <% when :text %>
              <%= s.label setting.key, setting.label %>
              <%= s.textarea setting.key, value:, rows: 3 %>
            <% else %>
              <%= s.label setting.key, setting.label %>
              <%= s.text_field setting.key, value: %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </fieldset>
  <% end %>

  <div class="form-check mb-3">
    <%= f.checkbox :visible %>
    <%= f.label :visible, "Show on dashboard", class: "form-check-label" %>
  </div>

  <%= f.submit "Save" %>
<% end %>
