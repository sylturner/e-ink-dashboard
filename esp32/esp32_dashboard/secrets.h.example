#pragma once

// Copy this file to secrets.h and fill in your values. Git ignores
// secrets.h, so Wi-Fi credentials stay local.

const char* WIFI_NAME = "YOUR_WIFI_NAME";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// Where the Rails app lives, no trailing slash. The panel posts its MAC
// here on first boot and stores the token it gets back in flash; every
// later request uses that token.
const char* SERVER_BASE_URL = "http://your-server.local:3000";
