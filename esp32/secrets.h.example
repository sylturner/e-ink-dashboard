#pragma once

// Copy this file to secrets.h, fill in your values, and keep secrets.h private.
// Git ignores secrets.h so Wi-Fi credentials and the optional API token stay local.

const char* WIFI_NAME = "YOUR_WIFI_NAME";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// No query string here; the sketch appends the selected view and 800x480 size.
const char* CALENDAR_BASE_URL = "http://YOUR_SERVER:4567/dashboard.bmp";

// The current Rails endpoint does not require a bearer token. Leave this blank
// unless you put the service behind a proxy that expects one.
const char* CALENDAR_TOKEN = "";
